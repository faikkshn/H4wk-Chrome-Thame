{
  "manifest_version": 3,
  "name": "H4WK Space Hacker Toolkit",
  "version": "1.0.0",
  "description": "Professional developer and security toolkit combining space age aesthetics with hacking culture. Built by H4WK for developers, hackers, and tech enthusiasts.",
  "author": "H4WK",
  "homepage_url": "https://github.com/faikkshn/H4wk-Chrome-Thame",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "H4WK Toolkit"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "cookies",
    "webRequest"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Open H4WK Toolkit"
    }
  },

  "theme": {
    "images": {
      "theme_ntp_background": "images/background.png"
    },
    "colors": {
      "frame": [15, 15, 35],
      "frame_inactive": [10, 10, 25],
      "frame_incognito": [20, 5, 35],
      "frame_incognito_inactive": [15, 5, 25],
      "toolbar": [20, 20, 45],
      "tab_text": [0, 255, 170],
      "tab_background_text": [120, 220, 255],
      "tab_background_text_inactive": [160, 170, 190],
      "tab_background_text_incognito": [220, 120, 255],
      "tab_background_text_incognito_inactive": [190, 100, 210],
      "bookmark_text": [0, 255, 170],
      "ntp_background": [10, 10, 25],
      "ntp_text": [0, 255, 170],
      "ntp_link": [120, 220, 255],
      "ntp_header": [25, 25, 55],
      "button_background": [35, 35, 70],
      "omnibox_background": [25, 25, 50],
      "omnibox_text": [0, 255, 170]
    },
    "tints": {
      "buttons": [0.6, 0.4, 0.7],
      "frame": [0.65, 0.5, 0.15],
      "frame_inactive": [0.65, 0.5, 0.08],
      "frame_incognito": [0.75, 0.7, 0.25],
      "frame_incognito_inactive": [0.75, 0.7, 0.12],
      "background_tab": [0.6, 0.45, 0.5]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat": "no-repeat",
      "ntp_logo_alternate": 1
    }
  }
}
